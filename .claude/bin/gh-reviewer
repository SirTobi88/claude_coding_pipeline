#!/usr/bin/env bash
# `gh`, acting as the reviewer bot account instead of the owner.
#
#   .claude/bin/gh-reviewer api "repos/{owner}/{repo}/pulls/123/reviews" -f commit_id=<sha> \
#     -f event=APPROVE -F body=@.pipeline-tmp/review-123.md
#
# Branch protection requires one approving review from someone who is not the
# PR's author. Every implementer pushes as the owner's account, so the only
# approval that can count is the bot's -- and only the reviewer agent uses this
# wrapper (.claude/hooks/bash_guard.sh refuses it to every other agent). That
# is what turns "never approve your own work" from a rule into something
# GitHub enforces. docs/Pipeline.md § Merging.
#
# It runs only the calls the review procedure makes
# (.claude/skills/github-pr-review/SKILL.md): the token is the one thing that
# makes an approval count, and it should be able to do nothing else -- not
# `auth token`, not `repo delete`, not an arbitrary API call.
#
# The token comes from $PIPELINE_REVIEWER_TOKEN, or from the file named by
# $PIPELINE_REVIEWER_TOKEN_FILE, or from `reviewer_token_file` in
# .claude/pipeline/config.json. It is handed to gh through the environment and
# never printed, passed on a command line, or written anywhere.
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Each call is matched whole -- command, target and every flag -- never by a
# prefix or a glob: in a bash `case` pattern `*` also matches `/` and `?`, and
# an endpoint that only ended in /pulls/<N>/reviews once let any API call
# through.
# Only gh's own placeholders, which gh fills from this checkout: a literal
# owner/repo could name any repository the bot can reach.
review_endpoint='^repos/\{owner\}/\{repo\}/pulls/[0-9]+/reviews$'

# `pr merge <N> [--auto] --squash --delete-branch --match-head-commit <sha>`
merge_flags_ok() {
    local squash=0 delete=0 sha=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --auto) ;;
            --squash) squash=1 ;;
            --delete-branch) delete=1 ;;
            --match-head-commit)
                [[ ${2:-} =~ ^[0-9a-f]+$ ]] || return 1
                sha=1; shift ;;
            *) return 1 ;;
        esac
        shift
    done
    [ "$squash$delete$sha" = 111 ]
}

# The review itself, each field exactly once: `-f commit_id=<sha>
# -f event=<EVENT> -F body=@<file>.md`. `-F` reads whatever file it names and
# a review body is public, so the body is a relative .md path that stays in
# the checkout: never absolute, never `..` -- the token file is neither.
review_fields_ok() {
    local commit=0 event=0 body=0
    while [ $# -gt 0 ]; do
        # The flag is its own word: `"-F body=@/abs" "body=@x.md"` would
        # otherwise pass the pattern below with a body the check never saw.
        case "$1" in -f|-F) ;; *) return 1 ;; esac
        case "$1 ${2:-}" in
            "-f commit_id="*) [[ $2 =~ ^commit_id=[0-9a-f]{1,40}$ ]] || return 1; commit=$((commit + 1)) ;;
            "-f event="*) [[ $2 =~ ^event=(APPROVE|REQUEST_CHANGES|COMMENT)$ ]] || return 1; event=$((event + 1)) ;;
            "-F body="*)
                [[ $2 =~ ^body=@[A-Za-z0-9_.-][A-Za-z0-9_./-]*\.md$ ]] && [[ ! /${2#body=@}/ =~ /\.\./ ]] ||
                    return 1
                body=$((body + 1)) ;;
            *) return 1 ;;
        esac
        shift 2
    done
    [ "$commit$event$body" = 111 ]
}

allowed=0
case "${1:-} ${2:-}" in
    "api user")
        # Read-only: who the token is. Bare, or with --jq.
        { [ $# -eq 2 ] || { [ $# -eq 4 ] && [ "$3" = "--jq" ]; }; } && allowed=1 ;;
    "api "*)
        [[ ${2#/} =~ $review_endpoint ]] && review_fields_ok "${@:3}" && allowed=1 ;;
    "pr view")
        [ $# -eq 3 ] && [[ $3 =~ ^[0-9]+$ ]] && allowed=1 ;;
    "pr merge")
        [[ ${3:-} =~ ^[0-9]+$ ]] && merge_flags_ok "${@:4}" && allowed=1 ;;
    "pr edit")
        [[ ${3:-} =~ ^[0-9]+$ ]] && [ $# -eq 5 ] && [ "$4" = "--add-label" ] &&
            case "$5" in spec-defect|status:needs-human) true ;; *) false ;; esac && allowed=1 ;;
esac
if [ "$allowed" = 0 ]; then
    echo "gh-reviewer: refusing 'gh ${1:-} ${2:-} ...' as the reviewer bot." >&2
    echo "It runs only the review's own calls: api user [--jq …];" >&2
    echo "api repos/{owner}/{repo}/pulls/<N>/reviews -f commit_id=… -f event=… -F body=@….md;" >&2
    echo "pr view <N>; pr merge <N> [--auto] --squash --delete-branch --match-head-commit <sha>;" >&2
    echo "pr edit <N> --add-label spec-defect|status:needs-human. Use plain gh for anything else." >&2
    exit 4
fi

if [ -n "${PIPELINE_REVIEWER_TOKEN:-}" ]; then
    token="$PIPELINE_REVIEWER_TOKEN"
else
    file="$("$here/pipeline" config reviewer_token_file 2>/dev/null)" || file=""
    if [ -z "$file" ] || [ ! -r "$file" ]; then
        echo "gh-reviewer: no reviewer token at ${file:-<unknown>}." >&2
        echo "Setup: docs/Pipeline.md § Setup." >&2
        exit 3
    fi
    # Read in bash, not by a program the caller's PATH chooses.
    token="$(< "$file")"
fi
token="${token//[[:space:]]/}"
if [ -z "$token" ]; then
    echo "gh-reviewer: the reviewer token is empty." >&2
    exit 3
fi

# gh runs with an environment of our own, never the caller's. gh and git read
# far more of it than any argument check sees: GH_REPO, GH_HOST, GIT_DIR and
# git config variables pick the repository; HOME, XDG_CONFIG_HOME and
# GH_CONFIG_DIR pick a config whose pager or socket would see the token; PATH
# picks which `gh` gets it. So:
#   - PATH is fixed, and gh is found on it -- not on the caller's;
#   - gh's config and HOME are an empty directory of the checkout's own;
#   - the working directory is the repository root, whose origin remote is
#     what `{owner}/{repo}` and `pr <N>` resolve to;
#   - only the network setup passes through (proxies, certificates), and on
#     Windows what a program needs to start at all.
# Bash reads BASH_ENV before this script runs, so that one stays the
# caller's: a guard rail, not a boundary (docs/Pipeline.md § Merging).
safe_path="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
safe_path="$safe_path:/mingw64/bin:/c/Program Files/GitHub CLI:/c/Program Files/Git/cmd"
gh_bin="$(PATH="$safe_path" command -v gh)"
if [ -z "$gh_bin" ]; then
    echo "gh-reviewer: gh is not installed in a standard place ($safe_path)." >&2
    exit 3
fi
root="$(cd "$here/../.." && pwd)"
own="$root/.pipeline-tmp/gh-reviewer"
mkdir -p "$own" || { echo "gh-reviewer: cannot create $own" >&2; exit 3; }
keep=()
for name in HTTPS_PROXY HTTP_PROXY ALL_PROXY NO_PROXY https_proxy http_proxy all_proxy no_proxy \
            SSL_CERT_FILE SSL_CERT_DIR SYSTEMROOT SystemRoot WINDIR windir COMSPEC ComSpec \
            PATHEXT TEMP TMP TMPDIR; do
    [ -n "${!name+x}" ] && keep+=("$name=${!name}")
done
cd "$root" || exit 3
# Cleared in bash, not with `env -i NAME=value …`: that would put the token on
# a command line, where any process listing shows it.
for name in $(compgen -e); do unset "$name" 2>/dev/null; done
for kv in ${keep[@]+"${keep[@]}"}; do export "$kv"; done
export PATH="$safe_path" HOME="$own" GH_CONFIG_DIR="$own" GH_NO_UPDATE_NOTIFIER=1 GH_PROMPT_DISABLED=1
GH_TOKEN="$token" GH_ENTERPRISE_TOKEN="$token" exec "$gh_bin" "$@"
